# Production .env for Hostinger. Create it once as /home/<user>/brewspot-api/.env
# (File Manager > New file). Replace every <...> value. Never commit the real file.

APP_NAME=BrewSpot
APP_ENV=production
APP_KEY=<run locally: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<your-domain>

# Same domain serves the Nuxt app and the API
FRONTEND_URL=https://<your-domain>

# Must match the DEPLOY_TOKEN GitHub secret (POST /api/deploy/migrate). Generate: openssl rand -hex 32
DEPLOY_TOKEN=<random hex>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_brewspot>
DB_USERNAME=<u123456789_brewspot>
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Hostinger mailbox (needs a real domain)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=<noreply@your-domain>
MAIL_PASSWORD=<mailbox password>
MAIL_FROM_ADDRESS=<noreply@your-domain>
MAIL_FROM_NAME="${APP_NAME}"

PAYMONGO_PUBLIC_KEY=<pk_...>
PAYMONGO_SECRET_KEY=<sk_...>
PAYMONGO_WEBHOOK_SECRET_KEY=<whsk_...>
PAYMONGO_SUCCESS_URL=https://<your-domain>/owner/subscription?checkout=success
PAYMONGO_CANCEL_URL=https://<your-domain>/owner/subscription?checkout=cancelled

PAYPAL_CLIENT_ID=<paypal client id>
PAYPAL_CLIENT_SECRET=<paypal client secret>
PAYPAL_WEBHOOK_ID=<paypal webhook id>
PAYPAL_MODE=sandbox
